# Gateway connections. All upstream services stay on loopback.
SAPR_DEMO_MODEL_URL=http://127.0.0.1:8001/v1
SAPR_DEMO_BASE_MODEL_NAME=sapr-base
SAPR_DEMO_MODEL_NAME=sapr-sft
SAPR_DEMO_RETRIEVAL_URL=http://127.0.0.1:8100

# Agent limits for the public demo.
SAPR_DEMO_MAX_TURNS=6
SAPR_DEMO_TOP_K=3
SAPR_DEMO_MAX_TOKENS=512
SAPR_DEMO_EVIDENCE_MAX_TOKENS=128
SAPR_DEMO_QUESTION_MAX_CHARS=500
SAPR_DEMO_MAX_CONCURRENT_REQUESTS=1
SAPR_DEMO_COOLDOWN_SECONDS=5

# Enable only when requests reach the gateway exclusively through Cloudflare Tunnel.
SAPR_DEMO_TRUST_CLOUDFLARE_IP=0

# Optional comma-separated origins when the frontend is hosted separately.
SAPR_DEMO_ALLOWED_ORIGINS=

# Replace this path when a better adapter is selected.
SAPR_DEMO_LORA_PATH=03_sapr_rag/models/sapr-rag-sft-lora/checkpoint-1650
SAPR_DEMO_MODEL_GPU=0
