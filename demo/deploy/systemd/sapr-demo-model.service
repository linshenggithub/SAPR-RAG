[Unit]
Description=SAPR-RAG vLLM model service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/sapr-rag/service.env
ExecStart=/usr/bin/env bash -lc 'exec "$SAPR_RAG_ROOT/demo/scripts/launch_demo_model.sh"'
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
