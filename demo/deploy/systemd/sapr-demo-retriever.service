[Unit]
Description=SAPR-RAG retrieval service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/sapr-rag/service.env
ExecStart=/usr/bin/env bash -lc 'exec "$SAPR_RAG_ROOT/demo/scripts/launch_demo_retriever.sh"'
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
