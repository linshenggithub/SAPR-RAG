# gate0/.env 模板（不入 git，参考自 gate0/.gitignore）
#
# 用法：
#   cp gate0/.env.example gate0/.env
#   # 把 <YOUR_KEY> 换成真实 key
#
# gate0/run_mcts_typed_vs_scalar_pilot.py 会先读 gate0/.env 的 DMXAPI_API_KEY，
# 没有再 fallback 到 OPENAI_API_KEY 环境变量。
#
# gate0/relabel_q_with_gpt4o.py 直接读 OPENAI_API_KEY / OPENAI_BASE_URL 环境变量。
# 用以下两条任一也行：
#   export OPENAI_API_KEY=...
#   export OPENAI_BASE_URL=https://www.dmxapi.cn/v1

DMXAPI_API_KEY=<YOUR_KEY>
DMXAPI_BASE_URL=https://www.dmxapi.cn/v1
DMXAPI_MODEL=gpt-4o
