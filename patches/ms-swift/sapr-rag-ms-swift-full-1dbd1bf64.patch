+                    query_ordinal += 1
+                cursor = start + len(turn_ids)
+            continue
+
+        # Backward-compatible fallback for callers without encoded input IDs.
+        student_positions = completion_mask[row].nonzero(as_tuple=True)[0]
+        selected: List[int] = []
+        for turn_ids, turn_loss_mask in zip(response_turns, loss_turns):
+            if len(turn_ids) != len(turn_loss_mask):
+                raise ValueError(
+                    f'response/loss token mismatch at sample {row}: '
+                    f'{len(turn_ids)} != {len(turn_loss_mask)}')
+            text = tokenizer.decode(turn_ids, skip_special_tokens=False).lower()
+            is_query = classify_action(text) == 'query'
+            this_ordinal = query_ordinal if is_query else -1
+            payload_offsets = (
+                query_payload_offsets(turn_ids)
+                if is_query and payload_only
+                else None
+            )
+            selected.extend(
+                this_ordinal
+                if payload_offsets is None or offset in payload_offsets
+                else -1
+                for offset, keep in enumerate(turn_loss_mask)
+                if keep
+            )
+            if is_query:
+                query_ordinal += 1
+        if len(selected) != student_positions.numel():
+            raise ValueError(
+                f'query index map token mismatch at sample {row}: '
+                f'selected_frame={len(selected)} completion={student_positions.numel()}')
+        if selected:
+            output[row, student_positions] = torch.tensor(selected, dtype=torch.long, device=output.device)
+    return output
