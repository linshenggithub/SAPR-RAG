+def build_teacher_action_mask(
+    samples: List[OnPolicySample],
+    completion_mask: torch.Tensor,
+    tokenizer: Any,
+    scope: str,
+    input_ids: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Build a student-frame mask for action-scoped privileged supervision.
+
+    Multi-turn schedulers keep each assistant response in a separate
+    ``response_token_ids`` entry. We classify the whole assistant turn by its
+    terminal protocol tag and scatter the selected turn tokens onto the same
+    encoded student frame. This is stricter than flattening by token count:
+    chat templates may add trainable assistant-boundary tokens that are absent
+    from ``response_token_ids``. Those template tokens keep the normal GRPO
+    advantage but do not receive privileged teacher supervision.
+    """
+    if scope == 'all':
+        return completion_mask.bool().clone()
+    if scope not in {'query', 'evidence', 'answer'}:
+        raise ValueError(f'Unsupported teacher_action_scope: {scope}')
+    if len(samples) != completion_mask.shape[0]:
+        raise ValueError(
+            f'sample/mask batch mismatch: samples={len(samples)} mask_batch={completion_mask.shape[0]}')
+    if input_ids is not None:
+        if input_ids.shape[0] != completion_mask.shape[0]:
+            raise ValueError(
+                f'input/mask batch mismatch: input={input_ids.shape[0]} mask_batch={completion_mask.shape[0]}')
+        if input_ids.shape[1] < completion_mask.shape[1]:
+            raise ValueError(
+                f'input frame shorter than completion frame: input={input_ids.shape[1]} '
+                f'completion={completion_mask.shape[1]}')
+
+    def classify_action(text: str) -> Optional[str]:
+        # Match SaprRagScheduler.check_finished: any answer tag terminates the
+        # turn before a query can be executed. Otherwise query is the action.
+        if '<answer>' in text:
+            return 'answer'
+        if '<query>' in text:
+            return 'query'
+        if '<evidence>' in text:
+            return 'evidence'
+        return None
+
+    output = torch.zeros_like(completion_mask, dtype=torch.bool)
+    for row, sample in enumerate(samples):
+        response_turns = sample.response_token_ids or []
+        if response_turns and isinstance(response_turns[0], int):
+            response_turns = [response_turns]
+
+        loss_turns = sample.response_loss_mask or []
+        if loss_turns and isinstance(loss_turns[0], int):
+            loss_turns = [loss_turns]
+        if not loss_turns:
+            loss_turns = [[1] * len(turn) for turn in response_turns]
+        if len(response_turns) != len(loss_turns):
+            raise ValueError(
+                f'response/loss turn mismatch at sample {row}: '
+                f'{len(response_turns)} != {len(loss_turns)}')
+
+        if input_ids is not None:
+            frame_ids = input_ids[row, -completion_mask.shape[1]:].tolist()
+            cursor = 0
+            for turn_idx, (turn_ids, turn_loss_mask) in enumerate(zip(response_turns, loss_turns)):
+                if len(turn_ids) != len(turn_loss_mask):
+                    raise ValueError(
+                        f'response/loss token mismatch at sample {row}: '
+                        f'{len(turn_ids)} != {len(turn_loss_mask)}')
+
+                start = None
+                max_start = len(frame_ids) - len(turn_ids)
+                for candidate in range(cursor, max_start + 1):
+                    if frame_ids[candidate:candidate + len(turn_ids)] != list(turn_ids):
+                        continue
+                    if all(
+                            not keep or bool(completion_mask[row, candidate + offset])
+                            for offset, keep in enumerate(turn_loss_mask)):
+                        start = candidate
+                        break
+                if start is None:
+                    raise ValueError(
+                        f'cannot align action tokens at sample {row}, turn {turn_idx}: '
+                        f'turn_tokens={len(turn_ids)} frame_tokens={len(frame_ids)} cursor={cursor}')
+
+                text = tokenizer.decode(turn_ids, skip_special_tokens=False).lower()
+                turn_selected = classify_action(text) == scope
+                for offset, keep in enumerate(turn_loss_mask):
+                    if keep and turn_selected:
+                        output[row, start + offset] = True
+                cursor = start + len(turn_ids)
+            continue
+
+        # Backward-compatible fallback for callers without encoded input IDs.
+        selected = []
+        for turn_ids, turn_loss_mask in zip(response_turns, loss_turns):
+            if len(turn_ids) != len(turn_loss_mask):
+                raise ValueError(
+                    f'response/loss token mismatch at sample {row}: '
+                    f'{len(turn_ids)} != {len(turn_loss_mask)}')
+            text = tokenizer.decode(turn_ids, skip_special_tokens=False).lower()
+            turn_selected = classify_action(text) == scope
+            selected.extend(turn_selected for keep in turn_loss_mask if keep)
+
+        student_positions = completion_mask[row].nonzero(as_tuple=True)[0]
+        if len(selected) != student_positions.numel():
+            raise ValueError(
+                f'action mask token mismatch at sample {row}: '
+                f'selected_frame={len(selected)} completion={student_positions.numel()}')
+        if selected:
+            output[row, student_positions] = torch.tensor(selected, dtype=torch.bool, device=output.device)
+    return output
+
