+class TestScopedTeacherViews(unittest.TestCase):
+
+    def _sample(self):
+        return OnPolicySample(
+            messages=[
+                {'role': 'system', 'content': 'system'},
+                {'role': 'user', 'content': 'question'},
+                {'role': 'assistant', 'content': 'query'},
+                {'role': 'user', 'content': 'retrieved evidence'},
+                {'role': 'assistant', 'content': 'answer'},
+            ],
+            teacher_query_prompt='reference search plan',
+            teacher_answer_prompt='gold answer context',
+        )
+
+    def test_query_privilege_appends_to_first_user(self):
+        sample = self._sample()
