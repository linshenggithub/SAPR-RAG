+            self.action_credit_gate == 'all' or all(abs(value) <= 1e-8 for value in values)
+            for values in group_to_values.values())
+        mode = 'train' if self.model.training else 'eval'
+        self._metrics[mode]['action_credit_gate_group_ratio'].append(
+            active_groups / max(len(group_to_values), 1))
