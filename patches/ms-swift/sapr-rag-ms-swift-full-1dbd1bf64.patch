index 000000000..7b83aca7d
--- /dev/null
+++ b/swift/rl_core/action_credit.py
@@ -0,0 +1,153 @@
+# Copyright (c) ModelScope Contributors. All rights reserved.
+"""Action-scoped credit assignment for multi-turn agentic RL (Evidence-Attributed GRPO).
+
+This module implements the *task-agnostic* half of action-level credit assignment. The
+standard GRPO advantage is a single per-sequence scalar broadcast to every response
+token, so a trajectory whose final answer is wrong pushes *all* of its turns down --
+including the query turn that actually retrieved the decisive evidence. That is the
+long-horizon credit-assignment problem: the outcome reward cannot tell which turn helped.
+
+Here we add a second, *per-turn* advantage term that is scattered only onto the tokens of
+the turn that produced it (e.g. each ``<query>`` turn receives its own evidence-gain
+signal). The environment/outcome GRPO advantage is left untouched; the per-turn term is
+*additive* on top of it::
+
+    A_token(t) = A_outcome(seq)                      # existing GRPO broadcast
+               + coef * A_action(turn(t))            # new: only on that turn's tokens
+
+The per-turn *raw* signal (e.g. "new gold evidence covered by this query") is produced by
+the task side (the SAPR reward plugin) and passed in as a per-sample vector; this module
+only (1) normalizes it within each prompt group per turn-slot and (2) scatters it to tokens
+via a turn-index map. Keeping the numeric core here (pure tensor / list functions) makes it
+backend-agnostic and unit-testable without a live trainer.
+"""
+
+from typing import Dict, List, Optional, Sequence
+
+import torch
+
+__all__ = [
+    'normalize_action_credit_by_group',
+    'scatter_turn_credit_to_tokens',
+]
+
+
+def normalize_action_credit_by_group(
+    credit_by_sample: Sequence[Optional[Sequence[float]]],
+    prompt_ids: Sequence[str],
+    num_generations: int,
+    scale: str = 'group_turn',
+) -> List[List[float]]:
+    """Normalize the raw per-turn credit vectors within each prompt group.
+
+    Mirrors GRPO's group normalization, but *per turn-slot*: for a given prompt, the
+    ``k``-th query turn across the ``K`` sampled trajectories forms one normalization
+    group. This is the multi-turn analogue of GiGPO's step-grouped micro-advantage and is
+    what lets a single good query stand out from its siblings even when every trajectory in
+    the group ends with the same (wrong) answer -- exactly the zero-variance-outcome case
+    where the plain GRPO advantage vanishes.
+
+    Trajectories have different query counts, so turn-slot ``k`` only groups the
+    trajectories that actually have a ``k``-th query; shorter trajectories simply do not
+    contribute to (or receive) slot ``k``.
+
+    Args:
+        credit_by_sample: length-``N`` sequence; entry ``i`` is that sample's raw per-turn
+            credit vector (one float per credited turn, in turn order) or ``None``/empty.
+        prompt_ids: length-``N`` prompt identifiers defining the groups.
+        num_generations: ``K`` (kept for signature parity / validation; grouping is by
+            ``prompt_id`` so variable group sizes are tolerated).
+        scale: ``'group_turn'`` centers and scales within (group, turn-slot);
+            ``'group_turn_center'`` only centers (subtracts the mean, no std division);
+            ``'none'`` returns the raw values unchanged.
+
+    Returns:
+        length-``N`` list of normalized per-turn vectors (same shape as the input vectors;
+        ``None`` inputs become empty lists).
+    """
+    del num_generations  # grouping is by prompt_id; K is not needed but kept for parity.
+    n = len(prompt_ids)
+    if len(credit_by_sample) != n:
+        raise ValueError(f'credit/prompt length mismatch: {len(credit_by_sample)} != {n}')
+
+    # Materialize to plain lists of floats (defensive copy; tolerate None/empty).
+    vectors: List[List[float]] = []
+    for vec in credit_by_sample:
+        if vec is None:
+            vectors.append([])
+        else:
+            vectors.append([float(x) for x in vec])
+
+    if scale == 'none':
+        return vectors
+
+    if scale not in {'group_turn', 'group_turn_center'}:
+        raise ValueError(f'Unsupported action_credit_scale: {scale!r}')
+
+    # Group sample indices by prompt id.
+    group_to_indices: Dict[str, List[int]] = {}
+    for idx, pid in enumerate(prompt_ids):
+        group_to_indices.setdefault(pid, []).append(idx)
+
+    out: List[List[float]] = [list(v) for v in vectors]
+    for _pid, idxs in group_to_indices.items():
+        max_turns = max((len(vectors[i]) for i in idxs), default=0)
+        for k in range(max_turns):
+            members = [i for i in idxs if k < len(vectors[i])]
+            if len(members) <= 1:
+                # A single (or zero) trajectory owns turn-slot k: no within-group contrast,
+                # so it yields no differential signal. Zero it out.
+                for i in members:
+                    out[i][k] = 0.0
+                continue
+            vals = torch.tensor([vectors[i][k] for i in members], dtype=torch.float32)
+            centered = vals - vals.mean()
+            if scale == 'group_turn':
+                std = vals.std(unbiased=True)
+                centered = centered / (std + 1e-4)
+            for pos, i in enumerate(members):
+                out[i][k] = float(centered[pos])
+    return out
+
+
+def scatter_turn_credit_to_tokens(
+    turn_credit: Sequence[Optional[Sequence[float]]],
+    turn_index_map: torch.Tensor,
+    completion_mask: torch.Tensor,
+) -> torch.Tensor:
+    """Scatter per-turn credit onto the response tokens of each turn.
+
+    Args:
+        turn_credit: length-``B`` sequence of per-turn credit vectors (already normalized).
+            Entry ``i`` is indexed by turn ordinal: ``turn_credit[i][k]`` is the credit for
+            the ``k``-th credited turn of sample ``i``.
+        turn_index_map: ``[B, T]`` long tensor; each response token holds the ordinal ``k``
+            of the credited turn it belongs to, or ``-1`` for tokens outside any credited
+            turn (template tokens, observations, non-credited actions).
+        completion_mask: ``[B, T]`` response-token mask; the returned term is zero outside it.
+
+    Returns:
+        ``[B, T]`` additive per-token credit term (before the coefficient is applied).
+    """
+    if turn_index_map.shape != completion_mask.shape:
+        raise ValueError(
+            f'turn_index_map shape {tuple(turn_index_map.shape)} != '
+            f'completion_mask shape {tuple(completion_mask.shape)}')
+    if len(turn_credit) != turn_index_map.shape[0]:
+        raise ValueError(
+            f'turn_credit length {len(turn_credit)} != batch {turn_index_map.shape[0]}')
+
+    out = torch.zeros_like(completion_mask, dtype=torch.float32)
+    comp_bool = completion_mask.bool()
+    for row in range(turn_index_map.shape[0]):
+        vec = turn_credit[row]
+        if not vec:
+            continue
+        idx_row = turn_index_map[row]
+        for k, value in enumerate(vec):
+            if value == 0.0:
+                continue
+            sel = (idx_row == k) & comp_bool[row]
+            if sel.any():
+                out[row, sel] = float(value)
+    return out
