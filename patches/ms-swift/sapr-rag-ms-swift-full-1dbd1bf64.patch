+"""Tests for Evidence-Attributed GRPO action-level credit assignment."""
+
+import unittest
+
+import torch
+
+from swift.rl_core.action_credit import (normalize_action_credit_by_group,
+                                         scatter_turn_credit_to_tokens)
+
+
+class TestNormalizeActionCredit(unittest.TestCase):
+
+    def test_group_turn_centering_and_scaling(self):
+        # One prompt, K=3 trajectories, each with a first query turn gain.
+        credit = [[1.0], [0.0], [0.5]]
+        prompt_ids = ['p', 'p', 'p']
+        out = normalize_action_credit_by_group(credit, prompt_ids, num_generations=3, scale='group_turn_center')
+        # Centered by the slot-0 mean (0.5): [0.5, -0.5, 0.0]
+        self.assertAlmostEqual(out[0][0], 0.5, places=5)
+        self.assertAlmostEqual(out[1][0], -0.5, places=5)
+        self.assertAlmostEqual(out[2][0], 0.0, places=5)
+
+    def test_variable_turn_counts_group_per_slot(self):
+        # Trajectory 0 has 2 query turns, trajectory 1 has 1. Slot 1 has a single owner
+        # -> no within-group contrast -> zeroed.
+        credit = [[1.0, 1.0], [0.0]]
+        prompt_ids = ['p', 'p']
+        out = normalize_action_credit_by_group(credit, prompt_ids, num_generations=2, scale='group_turn_center')
+        self.assertAlmostEqual(out[0][0], 0.5, places=5)
+        self.assertAlmostEqual(out[1][0], -0.5, places=5)
+        # slot 1 only owned by trajectory 0 -> zero
+        self.assertEqual(out[0][1], 0.0)
+
+    def test_separate_prompts_do_not_mix(self):
+        credit = [[1.0], [1.0]]
+        prompt_ids = ['a', 'b']
+        out = normalize_action_credit_by_group(credit, prompt_ids, num_generations=1, scale='group_turn_center')
+        # Each prompt-slot has a single owner -> zeroed (no contrast).
+        self.assertEqual(out[0][0], 0.0)
+        self.assertEqual(out[1][0], 0.0)
+
+    def test_scale_none_passthrough(self):
+        credit = [[0.3, 0.7], None]
+        out = normalize_action_credit_by_group(credit, ['p', 'p'], num_generations=2, scale='none')
+        self.assertEqual(out[0], [0.3, 0.7])
+        self.assertEqual(out[1], [])
+
+    def test_group_turn_scaling_unit_std(self):
+        credit = [[2.0], [0.0]]
+        out = normalize_action_credit_by_group(credit, ['p', 'p'], num_generations=2, scale='group_turn')
+        # centered [1,-1]; std (unbiased) = sqrt(2); /(std+1e-4) ~ +/-0.707
+        self.assertAlmostEqual(out[0][0], 1.0 / (2 ** 0.5 + 1e-4), places=4)
+        self.assertAlmostEqual(out[1][0], -1.0 / (2 ** 0.5 + 1e-4), places=4)
+
+    def test_length_mismatch_raises(self):
+        with self.assertRaises(ValueError):
+            normalize_action_credit_by_group([[1.0]], ['p', 'p'], num_generations=1)
+
+
+class TestScatterTurnCredit(unittest.TestCase):
+
+    def test_scatter_by_turn_ordinal(self):
+        # 1 sample, 6 tokens; turns: q0 at [0,1], q1 at [3,4]; token 2,5 outside.
+        turn_index_map = torch.tensor([[0, 0, -1, 1, 1, -1]])
+        completion_mask = torch.tensor([[1, 1, 1, 1, 1, 1]])
+        credit = [[0.5, -0.25]]
+        out = scatter_turn_credit_to_tokens(credit, turn_index_map, completion_mask)
+        expected = torch.tensor([[0.5, 0.5, 0.0, -0.25, -0.25, 0.0]])
+        torch.testing.assert_close(out, expected)
+
+    def test_masked_tokens_get_no_credit(self):
+        turn_index_map = torch.tensor([[0, 0, 1, 1]])
+        completion_mask = torch.tensor([[1, 0, 1, 1]])  # token1 not a completion token
+        credit = [[1.0, 2.0]]
+        out = scatter_turn_credit_to_tokens(credit, turn_index_map, completion_mask)
+        expected = torch.tensor([[1.0, 0.0, 2.0, 2.0]])
+        torch.testing.assert_close(out, expected)
+
+    def test_empty_credit_is_zero(self):
+        turn_index_map = torch.tensor([[-1, -1, -1]])
+        completion_mask = torch.tensor([[1, 1, 1]])
+        out = scatter_turn_credit_to_tokens([[]], turn_index_map, completion_mask)
+        torch.testing.assert_close(out, torch.zeros(1, 3))
+
+    def test_shape_mismatch_raises(self):
+        with self.assertRaises(ValueError):
+            scatter_turn_credit_to_tokens([[1.0]], torch.zeros(1, 3, dtype=torch.long), torch.zeros(1, 4))
+
+
+if __name__ == '__main__':
+    unittest.main()
