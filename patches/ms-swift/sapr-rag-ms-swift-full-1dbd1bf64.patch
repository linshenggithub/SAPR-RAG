+        sample = OnPolicySample(
+            messages=[],
+            response_token_ids=[[1, 11], [1, 12], [2, 22]],
+            response_loss_mask=[[1, 1], [1, 1], [1, 1]],
+        )
+        completion_mask = torch.tensor([[True, True, True, True, True, True]])
+        result = build_query_turn_index_map([sample], completion_mask, _FakeTokenizer())
+        # q0 -> ordinal 0, q1 -> ordinal 1, answer -> -1
+        torch.testing.assert_close(result, torch.tensor([[0, 0, 1, 1, -1, -1]]))
+
+    def test_answer_and_evidence_excluded(self):
+        sample = OnPolicySample(
+            messages=[],
+            response_token_ids=[[2, 22]],
+            response_loss_mask=[[1, 1]],
