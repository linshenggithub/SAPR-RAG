+        """Build local per-query return advantages from existing reward components."""
+        key = self.action_credit_infos_key
+        local_gains: List[List[float]] = []
+        for sample in samples:
+            info = sample.rollout_infos or {}
+            gains = info.get(key) if isinstance(info, dict) else None
+            local_gains.append([float(value) for value in gains] if gains else [])
+        total_gains = gather_object(local_gains)
+        total_prompt_ids = gather_object([sample.prompt_id for sample in samples])
+        if len(total_gains) != len(total_prompt_ids):
+            raise ValueError(
+                f'causal-return gather mismatch: gains={len(total_gains)} '
+                f'prompt_ids={len(total_prompt_ids)}')
+
+        relevance_name = next(
+            (name for name in ('sapr_relevance', 'SaprRelevanceORM') if name in self.reward_func_names),
+            None,
+        )
+        if relevance_name is None:
+            raise ValueError('causal-return advantages require the sapr_relevance reward')
+        relevance_index = self.reward_func_names.index(relevance_name)
+        relevance_rewards = torch.nan_to_num(self._rewards_per_func[:, relevance_index], nan=0.0)
+        sequence_rewards = torch.nan_to_num(
+            self._rewards_per_func * self.reward_weights.unsqueeze(0), nan=0.0
+        ).sum(dim=1)
+        relevance_weight = float(self.reward_weights[relevance_index].item())
+        query_advantages = compute_causal_query_return_advantages(
+            sequence_rewards=sequence_rewards,
+            sequence_advantages=sequence_advantages,
+            relevance_rewards=relevance_rewards,
+            turn_gains=total_gains,
+            prompt_ids=total_prompt_ids,
+            num_generations=self.num_generations,
+            relevance_weight=relevance_weight,
+            scale=self.action_credit_scale,
+        )
+
+        sequence_advantage_values = sequence_advantages.detach().float().cpu().tolist()
+        late_deltas = [
+            abs(value - sequence_advantage_values[index])
+            for index, values in enumerate(query_advantages)
+            for value in values[1:]
+        ]
+        mode = 'train' if self.model.training else 'eval'
+        self._metrics[mode]['causal_return_late_delta_abs_mean'].append(
+            sum(late_deltas) / len(late_deltas) if late_deltas else 0.0)
+        self._metrics[mode]['causal_return_late_query_count'].append(float(len(late_deltas)))
+        return get_even_process_data(self, query_advantages)
