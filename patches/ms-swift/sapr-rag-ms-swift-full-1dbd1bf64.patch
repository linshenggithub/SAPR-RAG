+"""Tests for outcome-signed query advantage reweighting."""
+
+import unittest
+
+import torch
+
+from swift.rl_core.action_credit import compose_outcome_signed_query_advantages
+
+
+class TestOutcomeSignedQueryAdvantages(unittest.TestCase):
+    def test_reweights_positive_and_negative_outcomes_symmetrically(self):
+        out = compose_outcome_signed_query_advantages(
+            sequence_advantages=torch.tensor([2.0, -2.0]),
+            turn_credit=[[1.0, -1.0], [1.0, -1.0]],
+            query_turn_index_map=torch.tensor(
+                [
+                    [0, 0, 1, -1],
+                    [0, 1, 1, -1],
+                ]
+            ),
+            completion_mask=torch.ones(2, 4),
+            credit_coef=0.25,
+            credit_clip=2.0,
+        )
+        torch.testing.assert_close(
+            out,
+            torch.tensor(
+                [
+                    [2.5, 2.5, 1.5, 2.0],
+                    [-1.5, -2.5, -2.5, -2.0],
+                ]
+            ),
+        )
+
+    def test_zero_advantage_stays_zero(self):
+        out = compose_outcome_signed_query_advantages(
+            sequence_advantages=torch.tensor([0.0]),
+            turn_credit=[[2.0]],
+            query_turn_index_map=torch.tensor([[0, 0]]),
+            completion_mask=torch.ones(1, 2),
+            credit_coef=0.25,
+            credit_clip=2.0,
+        )
+        torch.testing.assert_close(out, torch.zeros(1, 2))
+
+    def test_clips_credit_and_preserves_non_query_tokens(self):
+        out = compose_outcome_signed_query_advantages(
+            sequence_advantages=torch.tensor([2.0]),
+            turn_credit=[[9.0]],
+            query_turn_index_map=torch.tensor([[0, -1, -1]]),
+            completion_mask=torch.tensor([[1, 1, 0]]),
+            credit_coef=0.25,
+            credit_clip=2.0,
+        )
+        torch.testing.assert_close(out, torch.tensor([[3.0, 2.0, 0.0]]))
+
+    def test_sign_preserving_constraint_is_enforced(self):
+        with self.assertRaises(ValueError):
+            compose_outcome_signed_query_advantages(
+                sequence_advantages=torch.tensor([1.0]),
+                turn_credit=[[-2.0]],
+                query_turn_index_map=torch.tensor([[0]]),
+                completion_mask=torch.ones(1, 1),
+                credit_coef=0.5,
+                credit_clip=2.0,
+            )
+
+    def test_invalid_shape_raises(self):
+        with self.assertRaises(ValueError):
+            compose_outcome_signed_query_advantages(
+                sequence_advantages=torch.tensor([1.0, -1.0]),
+                turn_credit=[[1.0]],
+                query_turn_index_map=torch.tensor([[0]]),
+                completion_mask=torch.ones(1, 1),
+                credit_coef=0.25,
+                credit_clip=2.0,
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
