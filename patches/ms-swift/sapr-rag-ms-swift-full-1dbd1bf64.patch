+def compute_teacher_sequence_gate(
+    rewards_per_func: torch.Tensor,
+    reward_func_names: List[str],
+    mode: str = 'none',
+    threshold: float = 1.0,
+) -> torch.Tensor:
+    """Select sequences that should receive an external-teacher OPD signal.
+
+    ``failed_em`` and ``failed_f1`` gate on the corresponding raw reward
+    column before reward weighting or group normalization. Non-finite scores
+    are treated as failures so malformed/unanswered trajectories do not
+    silently bypass teacher correction.
+    """
+    batch_size = rewards_per_func.shape[0]
+    if mode == 'none':
+        return torch.ones(batch_size, dtype=torch.bool, device=rewards_per_func.device)
+    reward_aliases = {
+        'failed_em': ('sapr_em', 'SaprEMORM'),
+        'failed_f1': ('sapr_f1', 'SaprF1ORM'),
+    }.get(mode)
+    if reward_aliases is None:
+        raise ValueError(f'Unsupported teacher_sequence_gate: {mode!r}')
+    reward_name = next((name for name in reward_aliases if name in reward_func_names), None)
+    if reward_name is None:
+        raise ValueError(
+            f'teacher_sequence_gate={mode!r} requires one of reward functions {reward_aliases!r}; '
+            f'available reward functions: {reward_func_names}')
+    values = rewards_per_func[:, reward_func_names.index(reward_name)]
+    return (~torch.isfinite(values)) | (values < threshold)
+
