+    def _compute_action_turn_credit(
+        self,
+        samples: List[GRPOSample],
+        outcome_advantages: torch.Tensor,
+    ) -> List[List[float]]:
+        """Group-normalize the per-query-turn credit and return the local per-sample vectors.
+
+        The raw per-turn credit vector for each sample is produced by the reward side and
+        carried in ``rollout_infos[action_credit_infos_key]`` (one float per executed query
+        turn, in order). We gather across processes, normalize within each prompt group per
+        turn-slot (:func:`normalize_action_credit_by_group`), then slice back to this process.
+        """
+        key = self.action_credit_infos_key
+        local_raw: List[List[float]] = []
+        for s in samples:
+            info = s.rollout_infos or {}
+            vec = info.get(key) if isinstance(info, dict) else None
+            local_raw.append([float(x) for x in vec] if vec else [])
+        total_raw = gather_object(local_raw)
+        total_prompt_ids = gather_object([s.prompt_id for s in samples])
+        if len(total_raw) != len(total_prompt_ids):
+            raise ValueError(
+                f'action credit gather mismatch: credit={len(total_raw)} prompt_ids={len(total_prompt_ids)}')
+        normalized = normalize_action_credit_by_group(
+            total_raw, total_prompt_ids, self.num_generations, scale=self.action_credit_scale)
+        outcome_values = outcome_advantages.detach().float().cpu().tolist()
+        gated = gate_action_credit_by_outcome(
