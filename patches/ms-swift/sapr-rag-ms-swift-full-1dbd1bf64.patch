+
+    def test_respects_environment_loss_mask(self):
+        # Middle token has loss_mask 0 (environment token spliced into the turn). In the
+        # no-input_ids fallback, completion_mask frames only the kept tokens (same contract
+        # as build_teacher_action_mask), so the two kept query tokens both get ordinal 0.
+        sample = OnPolicySample(
+            messages=[],
+            response_token_ids=[[1, 11, 12]],
+            response_loss_mask=[[1, 0, 1]],
+        )
+        completion_mask = torch.tensor([[True, True]])
+        result = build_query_turn_index_map([sample], completion_mask, _FakeTokenizer())
+        torch.testing.assert_close(result, torch.tensor([[0, 0]]))
+
+    def test_input_ids_frame_alignment(self):
+        # Query turn tokens (11,12) and answer (21,22) separated by env tokens in the frame.
+        input_ids = torch.tensor([[101, 11, 12, 151645, 301, 21, 22, 151645]])
+        completion_mask = torch.tensor([[False, True, True, True, False, True, True, True]])
+
+        class _FrameTok:
+
+            def decode(self, token_ids, skip_special_tokens=False):
+                del skip_special_tokens
+                return {11: '<query>q</query>', 21: '<answer>a</answer>'}[token_ids[0]]
+
+        sample = OnPolicySample(
+            messages=[],
+            response_token_ids=[[11, 12], [21, 22]],
+            response_loss_mask=[[1, 1], [1, 1]],
+        )
+        result = build_query_turn_index_map([sample], completion_mask, _FrameTok(), input_ids=input_ids)
+        # query tokens at frame positions 1,2 -> ordinal 0; answer tokens -> -1; env/template -> -1
