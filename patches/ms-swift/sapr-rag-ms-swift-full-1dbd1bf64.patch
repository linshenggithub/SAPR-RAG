+        for prompt_id, credit in zip(total_prompt_ids, gated):
+            group_to_credit[prompt_id].extend(credit)
+        nonzero_groups = sum(any(abs(value) > 1e-8 for value in values) for values in group_to_credit.values())
+        self._metrics[mode]['action_credit_nonzero_group_ratio'].append(
+            nonzero_groups / max(len(group_to_credit), 1))
+        return get_even_process_data(self, gated)
