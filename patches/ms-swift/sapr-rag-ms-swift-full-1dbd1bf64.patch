+"""Tests for Action-Causal GRPO advantage routing."""
+
+import unittest
+
+import torch
+
+from swift.rl_core.action_credit import (
+    compose_action_causal_advantages,
+    normalize_sequence_credit_by_group,
+)
+
+
+class TestNormalizeSequenceCredit(unittest.TestCase):
+    def test_matches_group_normalization(self):
+        values = torch.tensor([1.0, 0.0, 0.5, 0.5])
+        out = normalize_sequence_credit_by_group(values, num_generations=2)
+        expected = torch.tensor(
+            [
+                0.5 / (2**0.5 / 2 + 1e-4),
+                -0.5 / (2**0.5 / 2 + 1e-4),
+                0.0,
+                0.0,
+            ]
+        )
+        torch.testing.assert_close(out, expected)
+
+    def test_invalid_group_shape_raises(self):
+        with self.assertRaises(ValueError):
+            normalize_sequence_credit_by_group(torch.ones(3), num_generations=2)
+
+
+class TestComposeActionCausalAdvantages(unittest.TestCase):
+    def test_routes_query_and_answer_signals(self):
+        answer_advantages = torch.tensor([2.0, -2.0])
+        turn_credit = [[1.0, -0.5], [-1.0]]
+        query_turn_index_map = torch.tensor(
+            [
+                [0, 0, -1, 1, -1, -1],
+                [0, -1, -1, -1, -1, -1],
+            ]
+        )
+        answer_mask = torch.tensor(
+            [
+                [0, 0, 0, 0, 1, 1],
+                [0, 0, 1, 1, 1, 0],
+            ]
+        )
+        completion_mask = torch.ones(2, 6)
+
+        out = compose_action_causal_advantages(
+            answer_advantages,
+            turn_credit,
+            query_turn_index_map,
+            answer_mask,
+            completion_mask,
+            query_outcome_coef=0.25,
+            query_credit_coef=0.5,
+        )
+        expected = torch.tensor(
+            [
+                [1.0, 1.0, 0.0, 0.25, 2.0, 2.0],
+                [-1.0, 0.0, -2.0, -2.0, -2.0, 0.0],
+            ]
+        )
+        torch.testing.assert_close(out, expected)
+
+    def test_wrong_answer_does_not_erase_positive_query_credit(self):
+        out = compose_action_causal_advantages(
+            torch.tensor([-1.0]),
+            [[1.0]],
+            torch.tensor([[0, 0, -1]]),
+            torch.tensor([[0, 0, 1]]),
+            torch.ones(1, 3),
+            query_outcome_coef=0.25,
+            query_credit_coef=0.5,
+        )
+        torch.testing.assert_close(out, torch.tensor([[0.25, 0.25, -1.0]]))
+
+    def test_unrouted_and_padding_tokens_are_zero(self):
+        out = compose_action_causal_advantages(
+            torch.tensor([1.0]),
+            [[1.0]],
+            torch.tensor([[0, -1, -1, -1]]),
+            torch.tensor([[0, 1, 0, 1]]),
+            torch.tensor([[1, 1, 1, 0]]),
+            query_outcome_coef=0.0,
+            query_credit_coef=1.0,
+        )
+        torch.testing.assert_close(out, torch.tensor([[1.0, 1.0, 0.0, 0.0]]))
+
+    def test_overlapping_masks_raise(self):
+        with self.assertRaises(ValueError):
+            compose_action_causal_advantages(
+                torch.tensor([1.0]),
+                [[1.0]],
+                torch.tensor([[0]]),
+                torch.tensor([[1]]),
+                torch.tensor([[1]]),
+                query_outcome_coef=0.25,
+                query_credit_coef=0.5,
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
