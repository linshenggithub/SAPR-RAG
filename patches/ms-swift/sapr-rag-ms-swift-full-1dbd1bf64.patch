+def build_query_turn_index_map(
+    samples: List[OnPolicySample],
+    completion_mask: torch.Tensor,
+    tokenizer: Any,
+    input_ids: Optional[torch.Tensor] = None,
+    payload_only: bool = False,
+) -> torch.Tensor:
+    """Build a ``[B, T]`` per-token map of *query-turn ordinals* in the student frame.
+
+    This is the token-alignment half of Evidence-Attributed GRPO. It mirrors
+    :func:`build_teacher_action_mask` exactly (same multi-turn token-subsequence alignment,
+    same ``classify_action`` protocol-tag rule, same strict loss-mask checks), but instead
+    of a binary action mask it returns, for every response token, the **ordinal ``k`` of the
+    query turn it belongs to** (0-based, counting only ``<query>`` turns in order), or
+    ``-1`` for any token outside a query turn (template tokens, observations, evidence /
+    answer turns).
+
+    The ordinal ``k`` is aligned with the task side's per-turn credit vector: the SAPR
+    reward plugin emits one evidence-gain value per executed query (one ``retrieved_steps``
+    entry per query turn, in order), so credit vector index ``k`` corresponds to the
+    ``k``-th ``<query>`` turn here. Turns that do not run a search still consume an ordinal
+    only if they are classified as ``query``; callers must build the credit vector with the
+    same "one entry per query turn" convention (see the plugin).
+
+    When ``payload_only`` is true, only the exact tagged query segment receives
+    the ordinal; reasoning text before the protocol tag remains ``-1``.
+
+    Returns:
+        ``[B, T]`` long tensor of query-turn ordinals (``-1`` outside query turns).
+    """
+    if len(samples) != completion_mask.shape[0]:
+        raise ValueError(
+            f'sample/mask batch mismatch: samples={len(samples)} mask_batch={completion_mask.shape[0]}')
+    if input_ids is not None:
+        if input_ids.shape[0] != completion_mask.shape[0]:
+            raise ValueError(
+                f'input/mask batch mismatch: input={input_ids.shape[0]} mask_batch={completion_mask.shape[0]}')
+        if input_ids.shape[1] < completion_mask.shape[1]:
+            raise ValueError(
+                f'input frame shorter than completion frame: input={input_ids.shape[1]} '
+                f'completion={completion_mask.shape[1]}')
+
+    def classify_action(text: str) -> Optional[str]:
+        # Identical to build_teacher_action_mask: an answer tag terminates the turn before a
+        # query can execute, so answer takes precedence over query, which precedes evidence.
+        if '<answer>' in text:
+            return 'answer'
+        if '<query>' in text:
+            return 'query'
+        if '<evidence>' in text:
+            return 'evidence'
+        return None
