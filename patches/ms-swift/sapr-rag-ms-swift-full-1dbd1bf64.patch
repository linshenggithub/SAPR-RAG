+# Copyright (c) ModelScope Contributors. All rights reserved.
+"""Action-scoped credit assignment for multi-turn agentic RL (Evidence-Attributed GRPO).
+
+This module implements the *task-agnostic* half of action-level credit assignment. The
+standard GRPO advantage is a single per-sequence scalar broadcast to every response
+token, so a trajectory whose final answer is wrong pushes *all* of its turns down --
+including the query turn that actually retrieved the decisive evidence. That is the
+long-horizon credit-assignment problem: the outcome reward cannot tell which turn helped.
+
+The additive mode adds a second, *per-turn* advantage term that is scattered only onto
+the tokens of the turn that produced it (e.g. each ``<query>`` turn receives its own
+evidence-gain signal). The environment/outcome GRPO advantage is left untouched::
+
+    A_token(t) = A_outcome(seq)                      # existing GRPO broadcast
+               + coef * A_action(turn(t))            # new: only on that turn's tokens
+
+The action-causal mode instead routes independently normalized answer quality to answer
+turns and combines discounted answer quality with local evidence gain on query turns.
+
+The per-turn *raw* signal (e.g. "new gold evidence covered by this query") is produced by
+the task side (the SAPR reward plugin) and passed in as a per-sample vector; this module
+only (1) normalizes it within each prompt group per turn-slot and (2) scatters it to tokens
+via a turn-index map. Keeping the numeric core here (pure tensor / list functions) makes it
+backend-agnostic and unit-testable without a live trainer.
+"""
+
+from typing import Dict, List, Optional, Sequence
+
+import torch
+
+__all__ = [
+    "compose_action_causal_advantages",
+    "compose_causal_return_advantages",
+    "compose_outcome_signed_query_advantages",
+    "compute_causal_query_return_advantages",
+    "gate_action_credit_by_outcome",
+    "normalize_action_credit_by_group",
+    "normalize_sequence_credit_by_group",
+    "scatter_turn_credit_to_tokens",
+]
+
+
+def compose_action_causal_advantages(
+    answer_advantages: torch.Tensor,
+    turn_credit: Sequence[Optional[Sequence[float]]],
+    query_turn_index_map: torch.Tensor,
+    answer_mask: torch.Tensor,
+    completion_mask: torch.Tensor,
+    query_outcome_coef: float,
+    query_credit_coef: float,
+) -> torch.Tensor:
+    """Route independently normalized rewards to the action tokens they supervise.
+
+    Answer turns receive only the answer-quality advantage. Query turns receive a
+    discounted long-horizon answer advantage plus their own per-turn evidence credit.
+    Tokens outside a recognized query/answer turn receive zero advantage.
+    """
+    if query_turn_index_map.shape != completion_mask.shape:
+        raise ValueError(
+            f"query map shape {tuple(query_turn_index_map.shape)} != "
+            f"completion mask shape {tuple(completion_mask.shape)}"
+        )
+    if answer_mask.shape != completion_mask.shape:
+        raise ValueError(
+            f"answer mask shape {tuple(answer_mask.shape)} != "
+            f"completion mask shape {tuple(completion_mask.shape)}"
+        )
+    if (
+        answer_advantages.ndim != 1
+        or answer_advantages.shape[0] != completion_mask.shape[0]
+    ):
+        raise ValueError(
+            f"answer advantages shape {tuple(answer_advantages.shape)} is incompatible "
+            f"with batch {completion_mask.shape[0]}"
+        )
+
+    completion = completion_mask.bool()
+    query_mask = (query_turn_index_map >= 0) & completion
+    answer_mask = answer_mask.bool() & completion
+    if (query_mask & answer_mask).any():
+        raise ValueError("query and answer action masks must be disjoint")
+
+    local_credit = scatter_turn_credit_to_tokens(
+        turn_credit, query_turn_index_map, completion_mask
+    )
+    answer_term = answer_advantages.to(
+        device=completion_mask.device, dtype=torch.float32
+    ).unsqueeze(1)
+    output = torch.zeros_like(completion_mask, dtype=torch.float32)
+    output = torch.where(
+        query_mask,
+        query_outcome_coef * answer_term + query_credit_coef * local_credit,
+        output,
+    )
+    output = torch.where(answer_mask, answer_term, output)
+    return output
+
+
+def compose_outcome_signed_query_advantages(
+    sequence_advantages: torch.Tensor,
+    turn_credit: Sequence[Optional[Sequence[float]]],
+    query_turn_index_map: torch.Tensor,
+    completion_mask: torch.Tensor,
+    credit_coef: float,
+    credit_clip: float,
+) -> torch.Tensor:
+    """Reweight query tokens without changing the sequence-advantage sign.
+
+    The standard GRPO advantage remains unchanged on non-query tokens. Query tokens use
+
+    ``A_query = A_seq + credit_coef * abs(A_seq) * clip(A_gain)``.
+
+    Positive evidence gain therefore strengthens a successful trajectory's query but
+    protects the same query from punishment in an unsuccessful trajectory. Negative gain
+    has the opposite effect. Requiring ``credit_coef * credit_clip < 1`` guarantees that
+    non-zero sequence advantages cannot cross zero.
+    """
+    if query_turn_index_map.shape != completion_mask.shape:
+        raise ValueError(
+            f"query map shape {tuple(query_turn_index_map.shape)} != "
+            f"completion mask shape {tuple(completion_mask.shape)}"
+        )
+    if (
+        sequence_advantages.ndim != 1
+        or sequence_advantages.shape[0] != completion_mask.shape[0]
+    ):
+        raise ValueError(
+            f"sequence advantages shape {tuple(sequence_advantages.shape)} is incompatible "
+            f"with batch {completion_mask.shape[0]}"
+        )
+    if credit_coef < 0.0:
+        raise ValueError(f"credit_coef must be non-negative, got {credit_coef}")
+    if credit_clip <= 0.0:
+        raise ValueError(f"credit_clip must be positive, got {credit_clip}")
+    if credit_coef * credit_clip >= 1.0:
+        raise ValueError(
+            "credit_coef * credit_clip must be < 1 to preserve advantage signs; "
+            f"got {credit_coef} * {credit_clip}"
+        )
+
+    completion = completion_mask.bool()
+    query_mask = (query_turn_index_map >= 0) & completion
+    local_credit = scatter_turn_credit_to_tokens(
+        turn_credit, query_turn_index_map, completion_mask
+    ).clamp(min=-credit_clip, max=credit_clip)
+    base = sequence_advantages.to(
+        device=completion_mask.device, dtype=torch.float32
+    ).unsqueeze(1)
+    output = base.expand_as(completion_mask).to(dtype=torch.float32)
+    query_advantage = base + credit_coef * base.abs() * local_credit
+    output = torch.where(query_mask, query_advantage, output)
+    return output * completion_mask.to(dtype=torch.float32)
+
+
+def compute_causal_query_return_advantages(
+    sequence_rewards: torch.Tensor,
+    sequence_advantages: torch.Tensor,
+    relevance_rewards: torch.Tensor,
+    turn_gains: Sequence[Optional[Sequence[float]]],
+    prompt_ids: Sequence[str],
+    num_generations: int,
+    relevance_weight: float,
+    scale: str = "group_turn",
+    atol: float = 1e-6,
+) -> List[List[float]]:
+    """Build per-query advantages from the evidence reward that remains attainable.
+
+    For query turn ``k``, the raw return keeps every non-relevance component of the
+    original sequence reward and replaces terminal relevance with evidence acquired
+    from ``k`` onward::
+
+        R_query(k) = R_sequence - w_rel * relevance
+                     + w_rel * sum(gain[j] for j >= k)
+
+    This removes evidence obtained before a query from that query's credit while still
+    propagating delayed evidence gains back to preparatory queries. The first query uses
+    the already-computed sequence advantage exactly, preserving standard GRPO at the
+    initial state. Later turns are normalized per prompt and turn slot; slots without
+    enough contrast fall back to the sequence advantage instead of being zeroed.
+    """
+    tensors = (sequence_rewards, sequence_advantages, relevance_rewards)
+    if any(value.ndim != 1 for value in tensors):
+        shapes = ", ".join(str(tuple(value.shape)) for value in tensors)
+        raise ValueError(f"causal-return inputs must be one-dimensional, got {shapes}")
+    n = sequence_rewards.numel()
+    if sequence_advantages.numel() != n or relevance_rewards.numel() != n:
+        raise ValueError(
+            "causal-return tensor length mismatch: "
+            f"rewards={n} advantages={sequence_advantages.numel()} "
+            f"relevance={relevance_rewards.numel()}"
+        )
+    if len(turn_gains) != n or len(prompt_ids) != n:
+        raise ValueError(
+            "causal-return metadata length mismatch: "
+            f"gains={len(turn_gains)} prompt_ids={len(prompt_ids)} samples={n}"
+        )
+    if relevance_weight < 0.0:
+        raise ValueError(
+            f"relevance_weight must be non-negative, got {relevance_weight}"
+        )
+    if scale not in {"group_turn", "group_turn_center"}:
+        raise ValueError(
+            "causal-return advantages require centered turn normalization, "
+            f"got {scale!r}"
+        )
+
+    rewards = sequence_rewards.detach().float().cpu()
+    base_advantages = sequence_advantages.detach().float().cpu()
+    relevance = relevance_rewards.detach().float().cpu()
+    vectors = [
+        [] if gains is None else [float(value) for value in gains]
+        for gains in turn_gains
+    ]
+
+    raw_returns: List[List[float]] = []
+    for index, gains in enumerate(vectors):
+        gain_sum = sum(gains)
+        if abs(gain_sum - float(relevance[index])) > atol:
+            raise ValueError(
+                "per-turn evidence gains must telescope to terminal relevance: "
+                f"sample={index} gains={gain_sum} relevance={float(relevance[index])}"
+            )
+        non_relevance_reward = (
+            float(rewards[index]) - relevance_weight * float(relevance[index])
+        )
+        remaining = 0.0
+        returns = [0.0] * len(gains)
+        for turn_index in range(len(gains) - 1, -1, -1):
+            remaining += gains[turn_index]
+            returns[turn_index] = (
+                non_relevance_reward + relevance_weight * remaining
+            )
+        raw_returns.append(returns)
+
+    normalized = normalize_action_credit_by_group(
+        raw_returns,
+        prompt_ids,
+        num_generations=num_generations,
+        scale=scale,
+    )
+
+    group_to_indices: Dict[str, List[int]] = {}
+    for index, prompt_id in enumerate(prompt_ids):
+        group_to_indices.setdefault(prompt_id, []).append(index)
+
+    # Keep standard GRPO wherever a turn slot has no usable within-group contrast.
+    for indices in group_to_indices.values():
+        max_turns = max((len(vectors[index]) for index in indices), default=0)
+        for turn_index in range(max_turns):
+            members = [
+                index for index in indices if turn_index < len(vectors[index])
+            ]
+            if turn_index == 0:
+                for index in members:
+                    normalized[index][turn_index] = float(base_advantages[index])
+                continue
+            values = torch.tensor(
+                [raw_returns[index][turn_index] for index in members],
+                dtype=torch.float32,
+            )
+            if len(members) <= 1 or torch.isclose(
+                values.std(unbiased=True), torch.tensor(0.0), atol=atol
+            ):
+                for index in members:
+                    normalized[index][turn_index] = float(base_advantages[index])
+
+    return normalized
+
+
+def compose_causal_return_advantages(
+    sequence_advantages: torch.Tensor,
+    query_turn_advantages: Sequence[Optional[Sequence[float]]],
+    query_turn_index_map: torch.Tensor,
+    completion_mask: torch.Tensor,
+) -> torch.Tensor:
+    """Replace only mapped query payloads with their causal return advantages."""
+    if query_turn_index_map.shape != completion_mask.shape:
+        raise ValueError(
+            f"query map shape {tuple(query_turn_index_map.shape)} != "
+            f"completion mask shape {tuple(completion_mask.shape)}"
+        )
+    if (
+        sequence_advantages.ndim != 1
+        or sequence_advantages.shape[0] != completion_mask.shape[0]
+    ):
+        raise ValueError(
+            f"sequence advantages shape {tuple(sequence_advantages.shape)} is incompatible "
+            f"with batch {completion_mask.shape[0]}"
+        )
+
+    completion = completion_mask.bool()
+    query_mask = (query_turn_index_map >= 0) & completion
+    query_values = scatter_turn_credit_to_tokens(
+        query_turn_advantages, query_turn_index_map, completion_mask
+    )
+    base = sequence_advantages.to(
+        device=completion_mask.device, dtype=torch.float32
+    ).unsqueeze(1)
+    output = base.expand_as(completion_mask).to(dtype=torch.float32)
+    output = torch.where(query_mask, query_values, output)
+    return output * completion_mask.to(dtype=torch.float32)
+
+
+def gate_action_credit_by_outcome(
+    credit_by_sample: Sequence[Optional[Sequence[float]]],
+    prompt_ids: Sequence[str],
+    outcome_advantages: Sequence[float],
+    mode: str = "all",
+    atol: float = 1e-8,
+) -> List[List[float]]:
+    """Keep action credit only where the outcome advantage has no group contrast.
+
+    ``zero_outcome`` is a conservative rescue mode: action credit is active only for
+    prompt groups whose sequence-level GRPO advantages are all zero. Non-zero outcome
+    groups remain exactly standard GRPO, avoiding redundant or conflicting updates.
+    """
+    n = len(prompt_ids)
+    if len(credit_by_sample) != n or len(outcome_advantages) != n:
+        raise ValueError(
+            f"action gate length mismatch: credit={len(credit_by_sample)} "
+            f"prompt_ids={n} outcome_advantages={len(outcome_advantages)}"
+        )
+
+    vectors = [
+        [] if vec is None else [float(x) for x in vec] for vec in credit_by_sample
+    ]
+    if mode == "all":
+        return vectors
+    if mode != "zero_outcome":
+        raise ValueError(f"Unsupported action_credit_gate: {mode!r}")
+
+    group_to_indices: Dict[str, List[int]] = {}
+    for idx, pid in enumerate(prompt_ids):
+        group_to_indices.setdefault(pid, []).append(idx)
+
+    active_prompt_ids = {
+        pid
+        for pid, idxs in group_to_indices.items()
+        if all(abs(float(outcome_advantages[i])) <= atol for i in idxs)
+    }
+    return [
+        vec if pid in active_prompt_ids else [0.0] * len(vec)
+        for vec, pid in zip(vectors, prompt_ids)
+    ]
+
+
+def normalize_action_credit_by_group(
+    credit_by_sample: Sequence[Optional[Sequence[float]]],
+    prompt_ids: Sequence[str],
+    num_generations: int,
+    scale: str = "group_turn",
+) -> List[List[float]]:
+    """Normalize the raw per-turn credit vectors within each prompt group.
+
+    Mirrors GRPO's group normalization, but *per turn-slot*: for a given prompt, the
+    ``k``-th query turn across the ``K`` sampled trajectories forms one normalization
+    group. This is the multi-turn analogue of GiGPO's step-grouped micro-advantage and is
+    what lets a single good query stand out from its siblings even when every trajectory in
+    the group ends with the same (wrong) answer -- exactly the zero-variance-outcome case
+    where the plain GRPO advantage vanishes.
+
+    Trajectories have different query counts, so turn-slot ``k`` only groups the
+    trajectories that actually have a ``k``-th query; shorter trajectories simply do not
+    contribute to (or receive) slot ``k``.
+
+    Args:
+        credit_by_sample: length-``N`` sequence; entry ``i`` is that sample's raw per-turn
+            credit vector (one float per credited turn, in turn order) or ``None``/empty.
+        prompt_ids: length-``N`` prompt identifiers defining the groups.
+        num_generations: ``K`` (kept for signature parity / validation; grouping is by
+            ``prompt_id`` so variable group sizes are tolerated).
+        scale: ``'group_turn'`` centers and scales within (group, turn-slot);
+            ``'group_turn_center'`` only centers (subtracts the mean, no std division);
+            ``'none'`` returns the raw values unchanged.
+
+    Returns:
+        length-``N`` list of normalized per-turn vectors (same shape as the input vectors;
+        ``None`` inputs become empty lists).
+    """
+    del (
+        num_generations
+    )  # grouping is by prompt_id; K is not needed but kept for parity.
+    n = len(prompt_ids)
+    if len(credit_by_sample) != n:
+        raise ValueError(
+            f"credit/prompt length mismatch: {len(credit_by_sample)} != {n}"
+        )
+
+    # Materialize to plain lists of floats (defensive copy; tolerate None/empty).
+    vectors: List[List[float]] = []
+    for vec in credit_by_sample:
+        if vec is None:
+            vectors.append([])
+        else:
+            vectors.append([float(x) for x in vec])
+
+    if scale == "none":
+        return vectors
+
+    if scale not in {"group_turn", "group_turn_center"}:
+        raise ValueError(f"Unsupported action_credit_scale: {scale!r}")
+
+    # Group sample indices by prompt id.
+    group_to_indices: Dict[str, List[int]] = {}
+    for idx, pid in enumerate(prompt_ids):
+        group_to_indices.setdefault(pid, []).append(idx)
+
+    out: List[List[float]] = [list(v) for v in vectors]
+    for _pid, idxs in group_to_indices.items():
+        max_turns = max((len(vectors[i]) for i in idxs), default=0)
+        for k in range(max_turns):
+            members = [i for i in idxs if k < len(vectors[i])]
+            if len(members) <= 1:
+                # A single (or zero) trajectory owns turn-slot k: no within-group contrast,
+                # so it yields no differential signal. Zero it out.
+                for i in members:
+                    out[i][k] = 0.0
+                continue
+            vals = torch.tensor([vectors[i][k] for i in members], dtype=torch.float32)
+            centered = vals - vals.mean()
+            if scale == "group_turn":
+                std = vals.std(unbiased=True)
+                centered = centered / (std + 1e-4)
+            for pos, i in enumerate(members):
+                out[i][k] = float(centered[pos])
+    return out
+
+
+def scatter_turn_credit_to_tokens(
+    turn_credit: Sequence[Optional[Sequence[float]]],
+    turn_index_map: torch.Tensor,
+    completion_mask: torch.Tensor,
+) -> torch.Tensor:
+    """Scatter per-turn credit onto the response tokens of each turn.
+
+    Args:
+        turn_credit: length-``B`` sequence of per-turn credit vectors (already normalized).
+            Entry ``i`` is indexed by turn ordinal: ``turn_credit[i][k]`` is the credit for
+            the ``k``-th credited turn of sample ``i``.
+        turn_index_map: ``[B, T]`` long tensor; each response token holds the ordinal ``k``
+            of the credited turn it belongs to, or ``-1`` for tokens outside any credited
+            turn (template tokens, observations, non-credited actions).
+        completion_mask: ``[B, T]`` response-token mask; the returned term is zero outside it.
+
+    Returns:
+        ``[B, T]`` additive per-token credit term (before the coefficient is applied).
+    """
+    if turn_index_map.shape != completion_mask.shape:
+        raise ValueError(
+            f"turn_index_map shape {tuple(turn_index_map.shape)} != "
+            f"completion_mask shape {tuple(completion_mask.shape)}"
+        )
+    if len(turn_credit) != turn_index_map.shape[0]:
+        raise ValueError(
+            f"turn_credit length {len(turn_credit)} != batch {turn_index_map.shape[0]}"
+        )
+
+    out = torch.zeros_like(completion_mask, dtype=torch.float32)
+    comp_bool = completion_mask.bool()
+    for row in range(turn_index_map.shape[0]):
+        vec = turn_credit[row]
+        if not vec:
+            continue
+        idx_row = turn_index_map[row]
+        for k, value in enumerate(vec):
+            if value == 0.0:
+                continue
+            sel = (idx_row == k) & comp_bool[row]
+            if sel.any():
+                out[row, sel] = float(value)
+    return out
+
+
+def normalize_sequence_credit_by_group(
+    values: torch.Tensor, num_generations: int
+) -> torch.Tensor:
+    """Apply standard GRPO group normalization to one reward component."""
+    if values.ndim != 1:
+        raise ValueError(
+            f"values must be one-dimensional, got shape {tuple(values.shape)}"
+        )
+    if num_generations <= 0 or values.numel() % num_generations:
+        raise ValueError(
+            f"values length {values.numel()} is not divisible by num_generations={num_generations}"
+        )
+    grouped = values.view(-1, num_generations)
+    centered = grouped - grouped.mean(dim=1, keepdim=True)
+    if num_generations > 1:
+        std = grouped.std(dim=1, keepdim=True)
+    else:
+        std = torch.zeros_like(grouped)
+    return (centered / (std + 1e-4)).reshape(-1)
